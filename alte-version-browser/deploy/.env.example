# Project Zero – Serverkonfiguration. Kopie als /etc/project-zero/env (oder .env für Docker)
# anlegen und anpassen. Diese Datei enthält keine Geheimnisse; echte Werte nie ins Repository.

# Netzwerk: der Server lauscht nur lokal, nach außen geht es über den Webserver (HTTPS).
PZ_HOST=127.0.0.1
PZ_PORT=8787

# Datenbank und Sicherungen (Verzeichnisse müssen dem Dienstkonto gehören)
PZ_DB=/var/lib/project-zero/project-zero.db
PZ_BACKUP_DIR=/var/lib/project-zero/backups
PZ_BACKUP_HOURS=6
PZ_BACKUP_KEEP=28

# Erlaubte Herkunft der Webseite (Komma-getrennt), z. B. https://example.de
PZ_ALLOWED_ORIGINS=https://example.de

# Anzeige
PZ_SERVER_NAME=Project Zero
PZ_MOTD=Willkommen in Haldenbruck!

# Konten und Spiel
PZ_ALLOW_REGISTRATION=true
PZ_ALLOW_TEST_ACCOUNTS=false
PZ_MAX_PER_INSTANCE=16
PZ_MAX_CHARS=4
PZ_RECONNECT_GRACE=90
PZ_SAVE_INTERVAL=20
PZ_SESSION_DAYS=30

# Hinter nginx/Apache: echte Client-IP aus X-Forwarded-For übernehmen
PZ_TRUST_PROXY=true

# Optional: der Spielserver liefert den Web-Client selbst aus (sonst macht das der Webserver)
# PZ_PUBLIC_DIR=/opt/project-zero/current/web
